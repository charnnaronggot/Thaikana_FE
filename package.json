{
  "name": "thaikana",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "preview": "serve -s dist/thaikana/browser -l 4300",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "api:generate": "npx --yes --package openapi-typescript@7.13.0 openapi-typescript ../docs/thaikana/references/openapi.json -o src/app/core/services/api/generated/schema.ts"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "22.2.1",
    "@lucide/angular": "^1.47.0",
    "decimal.js": "^10.6.0",
    "jsbarcode": "^3.12.3",
    "pdfmake": "^0.3.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@playwright/test": "^1.63.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pngjs": "^6.0.5",
    "@zxing/library": "^0.23.0",
    "fake-indexeddb": "^6.2.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
